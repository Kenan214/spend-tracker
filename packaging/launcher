#!/bin/bash
# Copied into Contents/MacOS/launcher by build_release.sh — this script IS
# the app's executable (CFBundleExecutable in Info.plist), run directly by
# Finder/launchd on double-click. No AppleScript wrapper: an osacompile
# applet seals its resources at build time, and this bundle's Resources
# are added after that point, which used to invalidate the seal and make
# macOS report the app as "damaged" — signing this bundle ourselves, once,
# after everything is in place, avoids that entirely.
#
# Keeps the venv and user data in ~/Library/Application Support instead of
# inside the .app bundle: the bundle may be running from a read-only,
# Gatekeeper-translocated location (macOS runs quarantined, unmoved .app
# bundles from a randomized read-only mount), so nothing here can rely on
# being able to write next to itself, or on paths outside the bundle being
# visible at all.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../Resources/app" && pwd)"
APP_BUNDLE="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SUPPORT_DIR="$HOME/Library/Application Support/Spend Tracker"
VENV_DIR="$SUPPORT_DIR/venv"
PENDING_DIR="$SUPPORT_DIR/pending_update"
UPDATE_LOG="/tmp/spend-tracker-updater.log"
# Floor set by requirements.txt's most demanding dependency (mcp>=2.0 needs
# Python >=3.10) — a venv built with anything older, e.g. the Python 3.9
# stub Xcode Command Line Tools installs at /usr/bin/python3 on Macs with no
# other Python, will "succeed" at venv creation but then fail every install
# of that package with a confusing "from versions: none" pip error.
MIN_PY_MAJOR=3
MIN_PY_MINOR=10

# A GUI-launched app (double-click in Finder) gets launchd's bare default
# PATH — /usr/bin:/bin:/usr/sbin:/sbin — not the PATH your Terminal has,
# since that only exists because a shell profile (~/.zprofile etc.) added
# it, and nothing sources shell profiles for a GUI launch. So Homebrew
# (/opt/homebrew/bin) and python.org's installer (which doesn't touch PATH
# at all) are both invisible unless we go looking for them explicitly.
eval "$(/usr/libexec/path_helper -s)"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"
for _pydir in /Library/Frameworks/Python.framework/Versions/*/bin \
              /opt/homebrew/opt/python@3.*/bin /usr/local/opt/python@3.*/bin; do
  [ -d "$_pydir" ] && PATH="$_pydir:$PATH"
done

alert() {
  osascript -e "display alert \"Spend Tracker\" message \"$1\" as critical" >/dev/null 2>&1
}

python_new_enough() {
  "$1" -c "import sys; sys.exit(0 if sys.version_info[:2] >= ($MIN_PY_MAJOR, $MIN_PY_MINOR) else 1)" 2>/dev/null
}

mkdir -p "$SUPPORT_DIR"
export SPEND_TRACKER_DATA_DIR="$SUPPORT_DIR"

# Self-update, part 1: apply an update staged by a previous launch's
# background check (see update_check.sh in Resources/app, spawned near the
# bottom of this script). READY is only ever touched after the new app is
# fully downloaded, extracted, and codesign-verified, so its presence alone
# is trustworthy. Swap the whole bundle rather than patching the running
# one in place — an ad-hoc signature covers the bundle as of the last
# `codesign`, and editing files after that invalidates it (macOS then
# reports the app as "damaged", not just "unidentified developer"). The two
# `mv`s below are same-volume renames, so they're effectively atomic and
# safe to do while this very script is executing out of the directory
# being renamed — the shell keeps reading from the already-open (now
# unlinked-by-name) old file until we `exec` into the new one below.
if [ -f "$PENDING_DIR/READY" ] && [ -d "$PENDING_DIR/Spend Tracker.app" ]; then
  echo "$(date): applying staged update from $PENDING_DIR" >>"$UPDATE_LOG"
  BACKUP_BUNDLE="$SUPPORT_DIR/previous_version.app"
  rm -rf "$BACKUP_BUNDLE"
  if mv "$APP_BUNDLE" "$BACKUP_BUNDLE" 2>>"$UPDATE_LOG" \
     && mv "$PENDING_DIR/Spend Tracker.app" "$APP_BUNDLE" 2>>"$UPDATE_LOG"; then
    rm -rf "$PENDING_DIR" "$BACKUP_BUNDLE"
    echo "$(date): update applied, relaunching from $APP_BUNDLE" >>"$UPDATE_LOG"
    exec "$APP_BUNDLE/Contents/MacOS/launcher"
  else
    # Swap failed partway (e.g. install location isn't writable by this
    # user) — restore the original app rather than leaving neither in
    # place, discard the update, and fall through to a normal launch.
    echo "$(date): update swap failed, restoring original" >>"$UPDATE_LOG"
    [ -d "$BACKUP_BUNDLE" ] && [ ! -d "$APP_BUNDLE" ] && mv "$BACKUP_BUNDLE" "$APP_BUNDLE"
    rm -rf "$PENDING_DIR"
  fi
fi

# An existing venv from a previous, older/broken interpreter attempt isn't
# good enough just because the directory exists — validate it, or rebuild.
if [ -d "$VENV_DIR" ] && ! python_new_enough "$VENV_DIR/bin/python3"; then
  rm -rf "$VENV_DIR"
fi

if [ ! -d "$VENV_DIR" ]; then
  osascript -e 'display notification "First launch — setting up, this can take a minute…" with title "Spend Tracker"' >/dev/null 2>&1
  {
    echo "$(date): looking for Python $MIN_PY_MAJOR.$MIN_PY_MINOR+, PATH=$PATH"
  } >>/tmp/spend-tracker.log
  # Try every python3.x on PATH, not just the first one: a broken install
  # (e.g. a Homebrew Python with a broken ensurepip/pyexpat, seen in testing)
  # or one too old for our dependencies shouldn't block launch if a working,
  # sufficiently new interpreter is also available.
  created=0
  for candidate in $(compgen -c python3 | sort -u); do
    command -v "$candidate" >/dev/null 2>&1 || { echo "  $candidate: not runnable" >>/tmp/spend-tracker.log; continue; }
    if ! python_new_enough "$candidate"; then
      echo "  $candidate: $("$candidate" --version 2>&1) — too old or broken" >>/tmp/spend-tracker.log
      continue
    fi
    echo "  $candidate: $("$candidate" --version 2>&1) — trying venv creation" >>/tmp/spend-tracker.log
    rm -rf "$VENV_DIR"
    if "$candidate" -m venv "$VENV_DIR" 2>>/tmp/spend-tracker.log; then
      created=1
      echo "  $candidate: venv created successfully" >>/tmp/spend-tracker.log
      break
    fi
  done
  if [ "$created" -ne 1 ]; then
    rm -rf "$VENV_DIR"
    alert "Couldn't set up Spend Tracker's Python environment — no Python $MIN_PY_MAJOR.$MIN_PY_MINOR+ install was found working. Install Python 3 from python.org, then relaunch Spend Tracker. (Details in /tmp/spend-tracker.log)"
    exit 1
  fi
fi

source "$VENV_DIR/bin/activate"
if ! pip install -q -r "$DIR/requirements.txt" 2>>/tmp/spend-tracker.log; then
  last_error="$(tail -3 /tmp/spend-tracker.log | tr '\n' ' ' | sed 's/"/\\"/g')"
  alert "Couldn't install Spend Tracker's dependencies: ${last_error:-see /tmp/spend-tracker.log for details}"
  exit 1
fi

# Self-update, part 2: kick off a background check for a newer release.
# Detached (nohup + disown + redirected fds) so it survives this shell
# exiting when the user quits the app, and entirely silent — no network,
# no newer release, a corrupted download, etc. must ever be visible to the
# user or block using the current install. Only real distributable builds
# carry a VERSION file (build_release.sh writes it); a dev checkout has
# none, so this is a no-op there.
if [ -f "$DIR/VERSION" ] && [ -x "$DIR/update_check.sh" ]; then
  CURRENT_VERSION="$(cat "$DIR/VERSION")"
  nohup "$DIR/update_check.sh" "$CURRENT_VERSION" >/dev/null 2>>"$UPDATE_LOG" &
  disown
fi

python "$DIR/src/spend_tracker/desktop_app.py"
